{
  "name": "pokemon-tcg-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Private, local-first browser tracker for English Pokemon TCG cards.",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "dexie": "^4.4.2"
  }
}
